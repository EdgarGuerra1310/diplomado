APP_ENV=development
APP_NAME=Copiloto Pedagogico Inteligente DIFODS
APP_HOST=0.0.0.0
APP_PORT=7001
API_PORT=7001
WEB_PORT=3000
DB_NAME=diplomado
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
# Si se deja vacío, la API lo construye usando las cinco variables DB_*.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://copilot:copilot@rabbitmq:5672//
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=copilot
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=copilot-evidencias
MOODLE_WEBHOOK_SECRET=change-me-in-production
MOODLE_BASE_URL=https://campusvirtual-sifods.minedu.gob.pe
MOODLE_TOKEN=replace-with-a-new-token
MOODLE_SERVICE_PATH=/webservice/rest/server.php
MOODLE_TIMEOUT_SECONDS=120
# Se pueden definir como valores iniciales y sobreescribir desde la pantalla.
MOODLE_COURSE_ID=2741
MOODLE_CM_ID=
MOODLE_INCLUDE_NAMES=false

AZURE_OPENAI_API_KEY=replace-with-a-new-key
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AI_ANALYSIS_ENABLED=true
AI_AUTO_ANALYSIS_ENABLED=false
AI_MAX_FILE_MB=20
AI_MAX_VIDEO_MB=500
AI_MAX_CHARS_PER_FILE=18000
AI_VIDEO_SAMPLE_FRAMES=6
AI_REQUEST_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
